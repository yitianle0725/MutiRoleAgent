# ==================== LLM 配置（OpenAI 兼容协议） ====================
# 默认连接阿里百炼 DashScope 兼容端点，修改以下三行即可切换到其他厂商。
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=MutiRoleAgent
# 兼容旧版 LangChain 命名；新配置优先使用上面的 LANGSMITH_* 变量
LANGSMITH_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
PROMPT_ROLEPLAY_VERSION=v1
PROMPT_DECISION_VERSION=v1
DECISION_MODEL=
ROLEPLAY_MODEL=
ACK_MODEL=
ROLEPLAY_MAX_TOKENS=1024
ACK_MAX_TOKENS=128

# P0 LangGraph 开发态 checkpoint；开启后使用内存 saver，重启后不会保留
LANGGRAPH_CHECKPOINT_ENABLED=false
LANGGRAPH_CHECKPOINT_MODE=memory
# LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.db

# 兼容旧变量名（MCP + Embedding fallback）
DASHSCOPE_API_KEY=sk-your-api-key-here

# ==================== Embedding 配置（v2 升级） ====================
# 当前使用 DashScope 原生 SDK (text-embedding-v4, 1024d)，零配置可用。
#
# 可选模式:
#   EMBEDDING_MODE=dashscope  默认，DashScope 原生 SDK
#   EMBEDDING_MODE=local      本地 bge-m3 模型 (需先下载: HF_ENDPOINT=https://hf-mirror.com)
#   EMBEDDING_MODE=cloud      OpenAI 兼容 /embeddings 端点
#   EMBEDDING_MODE=auto       降级链: local → cloud → dashscope
#
EMBEDDING_MODE=dashscope
# HF_ENDPOINT=https://hf-mirror.com  # 国内用户下载本地模型时启用
#
# 云端配置（EMBEDDING_MODE=cloud 或 auto 降级时生效）:
# EMBEDDING_API_KEY=sk-your-embedding-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# ==================== 高德地图 API Key（可选） ====================
# 默认使用 Open-Meteo（免费全球天气）+ ip-api.com（免费 IP 定位），无需任何 Key。
# 配置此项后自动切换为高德天气 + 高德 IP 定位（国内数据更精准）。
# 免费注册: https://lbs.amap.com/
# AMAP_API_KEY=your_amap_key_here

# ==================== 语音对话（阿里云百炼，可选） ====================
# 使用实时 ASR / 流式 TTS 前配置。未配置时，文字聊天不受影响。
# 建议单独创建语音专用 API Key；请勿将真实密钥提交到仓库。
# VOICE_ENABLED=false
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# DASHSCOPE_WORKSPACE_ID=你的业务空间 ID（北京地域需要）
# ALI_DASHSCOPE_WS_URL=wss://你的业务空间 ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# ALI_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
# ALI_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
# ALI_TTS_MODEL=qwen-audio-3.0-tts-plus
# ALI_TTS_VOICE=longanhuan_v3.6

# ==================== Web 搜索 MCP（可选） ====================
# 不设则走 DashScope MCP（需要 DASHSCOPE_API_KEY）。
# 自建 WebSearch MCP 服务时可覆盖:
#
# WEBSEARCH_MCP_URL=https://your-mcp-server/websearch/mcp
# WEBSEARCH_MCP_KEY=your_key

# ==================== 切换厂商示例 ====================

# DeepSeek:
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Kimi (Moonshot):
# LLM_API_KEY=sk-your-kimi-key
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# Ollama 本地模型:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# OpenAI:
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
